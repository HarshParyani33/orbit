# ==============================================================================
# PROJECT ORBIT — LOCAL ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Application Runtime Mode
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# PostgreSQL Database Provisioning & Connections (Strict Role Separation)
# ------------------------------------------------------------------------------
# Dev container superuser password (REQUIRED by docker compose — no default fallback allowed)
# In production or local dev, generate a strong, unique secret (e.g. `openssl rand -hex 32` or a secure password generator).
# Never use predictable default passwords. Copy this template to .env and configure your secret before launching containers.
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_RANDOM_SECRET_FOR_POSTGRES_SUPERUSER

# 1. orbit_app: Application Runtime (NOSUPERUSER, NOBYPASSRLS, Explicit Table DML)
DATABASE_URL=postgresql://orbit_app:orbit_app_pass@127.0.0.1:5432/orbit_db?schema=public

# 2. orbit_migrator: DDL & Migration Owner (NOSUPERUSER, BYPASSRLS)
MIGRATION_DATABASE_URL=postgresql://orbit_migrator:orbit_migrator_pass@127.0.0.1:5432/orbit_db?schema=public

# 3. orbit_ingress: Pre-Tenant Webhook Routing (NOSUPERUSER, ZERO Table Access)
INGRESS_DATABASE_URL=postgresql://orbit_ingress:orbit_ingress_pass@127.0.0.1:5432/orbit_db?schema=public

# ------------------------------------------------------------------------------
# Redis Cache & Queue
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# Authentication Secrets & Cryptographic Salts
# ------------------------------------------------------------------------------
JWT_SECRET=dev_jwt_secret_key_minimum_32_characters_for_security_testing
COOKIE_SECRET=dev_cookie_signing_secret_key_32_characters_long
WIDGET_JWT_SECRET=dev_widget_session_signing_secret_key_32_characters
