# ==============================================================================
# PROJECT ORBIT — LOCAL ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
#
# INSTRUCTIONS FOR LOCAL DEVELOPMENT & DEPLOYMENT:
# 1. Copy this template to .env:
#    cp .env.example .env
# 2. Generate strong, unique cryptographic secrets:
#    openssl rand -hex 32
# 3. Never commit .env to version control (.env is gitignored).
# ==============================================================================

# Application Runtime Mode
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# PostgreSQL Database Provisioning & Connections (Strict Role Separation)
# ------------------------------------------------------------------------------
# Dev container superuser password (REQUIRED by docker compose — no default fallback allowed)
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_RANDOM_SECRET_FOR_POSTGRES_SUPERUSER

# Optional container role password overrides (defaults to local dev credentials if unset)
ORBIT_APP_PASSWORD=CHANGE_ME_GENERATE_RANDOM_SECRET_FOR_ORBIT_APP
ORBIT_MIGRATOR_PASSWORD=CHANGE_ME_GENERATE_RANDOM_SECRET_FOR_ORBIT_MIGRATOR
ORBIT_INGRESS_PASSWORD=CHANGE_ME_GENERATE_RANDOM_SECRET_FOR_ORBIT_INGRESS

# 1. orbit_app: Application Runtime (NOSUPERUSER, NOBYPASSRLS, Explicit Table DML)
# Local dev default URL: postgresql://orbit_app:orbit_app_pass@127.0.0.1:5432/orbit_db?schema=public
DATABASE_URL=postgresql://orbit_app:CHANGE_ME_ORBIT_APP_PASSWORD@127.0.0.1:5432/orbit_db?schema=public

# 2. orbit_migrator: DDL & Migration Owner (NOSUPERUSER, BYPASSRLS)
# Local dev default URL: postgresql://orbit_migrator:orbit_migrator_pass@127.0.0.1:5432/orbit_db?schema=public
MIGRATION_DATABASE_URL=postgresql://orbit_migrator:CHANGE_ME_ORBIT_MIGRATOR_PASSWORD@127.0.0.1:5432/orbit_db?schema=public

# 3. orbit_ingress: Pre-Tenant Webhook Routing (NOSUPERUSER, ZERO Table Access)
# Local dev default URL: postgresql://orbit_ingress:orbit_ingress_pass@127.0.0.1:5432/orbit_db?schema=public
INGRESS_DATABASE_URL=postgresql://orbit_ingress:CHANGE_ME_ORBIT_INGRESS_PASSWORD@127.0.0.1:5432/orbit_db?schema=public

# ------------------------------------------------------------------------------
# Redis Cache & Queue
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# Authentication Secrets & Cryptographic Salts
# In production, must be at least 32 characters and cannot match dev defaults.
# ------------------------------------------------------------------------------
JWT_SECRET=dev_jwt_secret_key_minimum_32_characters_for_security_testing
COOKIE_SECRET=dev_cookie_signing_secret_key_32_characters_long
WIDGET_JWT_SECRET=dev_widget_session_signing_secret_key_32_characters
