datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// 1. GLOBAL IDENTITY & MEMBERSHIP MODELS (Category D — Application Guarded)
// ==============================================================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  name         String   @db.VarChar(128)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  status       String   @default("ACTIVE") @db.VarChar(24) // ACTIVE, SUSPENDED, DELETED
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  sessions    UserSession[]
  memberships OrganizationMembership[]

  @@map("users")
}

model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(128)
  familyId  String   @default(uuid()) @map("family_id") @db.Uuid
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("user_sessions")
}

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(128)
  slug      String    @unique @db.VarChar(64)
  status    String    @default("ACTIVE") @db.VarChar(24) // ACTIVE, SUSPENDED, PENDING_DELETION, DELETED
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  memberships        OrganizationMembership[]
  channels           Channel[]
  aiConfigurations   AiConfiguration[]
  automationRules    AutomationRule[]
  webhookEvents      WebhookEvent[]
  messageAttachments MessageAttachment[]
  subscription       Subscription?
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks    KnowledgeChunk[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           String   @default("MEMBER") @db.VarChar(24) // OWNER, ADMIN, MEMBER
  status         String   @default("ACTIVE") @db.VarChar(24) // ACTIVE, INVITED, SUSPENDED
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId], name: "uq_membership_org_user")
  @@index([userId])
  @@map("organization_memberships")
}

// ==============================================================================
// 2. TENANT-DOMAIN DATA MODELS (Category A — Governed by PostgreSQL RLS)
// ==============================================================================

model Channel {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  provider       String    @db.VarChar(32) // META_WHATSAPP, META_INSTAGRAM, WEB_CHAT
  name           String    @db.VarChar(64)
  status         String    @default("ACTIVE") @db.VarChar(24)
  config         Json      @default("{}")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  routingLookups     ChannelRoutingLookup[]
  conversations      Conversation[]
  customerIdentities CustomerChannelIdentity[]
  webhookEvents      WebhookEvent[]

  @@unique([id, organizationId], name: "uq_channels_id_org")
  @@index([organizationId])
  @@map("channels")
}

model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(128)
  email          String?   @db.VarChar(255)
  phone          String?   @db.VarChar(64)
  metadata       Json      @default("{}")
  mergedIntoId   String?   @map("merged_into_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  mergedInto        Customer?                 @relation("CustomerMerges", fields: [mergedIntoId, organizationId], references: [id, organizationId], onDelete: Restrict)
  mergedFrom        Customer[]                @relation("CustomerMerges")
  channelIdentities CustomerChannelIdentity[]
  conversations     Conversation[]
  sourceMerges      CustomerMergeAudit[]      @relation("SourceCustomerMerges")
  targetMerges      CustomerMergeAudit[]      @relation("TargetCustomerMerges")

  @@unique([id, organizationId], name: "uq_customers_id_org")
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@index([organizationId, createdAt])
  @@map("customers")
}

model CustomerChannelIdentity {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  channelId      String   @map("channel_id") @db.Uuid
  provider       String   @db.VarChar(32)
  externalId     String   @map("external_id") @db.VarChar(128)
  verified       Boolean  @default(false)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  customer Customer @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  channel  Channel  @relation(fields: [channelId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([channelId, externalId], name: "uq_channel_identities_channel_ext")
  @@unique([id, organizationId], name: "uq_channel_identities_id_org")
  @@index([organizationId, customerId])
  @@map("customer_channel_identities")
}

model CustomerMergeAudit {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  sourceCustomerId  String   @map("source_customer_id") @db.Uuid
  targetCustomerId  String   @map("target_customer_id") @db.Uuid
  performedByUserId String?  @map("performed_by_user_id") @db.Uuid
  reason            String   @db.VarChar(255)
  snapshot          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()

  sourceCustomer Customer @relation("SourceCustomerMerges", fields: [sourceCustomerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  targetCustomer Customer @relation("TargetCustomerMerges", fields: [targetCustomerId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, targetCustomerId])
  @@index([organizationId, sourceCustomerId])
  @@map("customer_merge_audits")
}

model Conversation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  channelId      String   @map("channel_id") @db.Uuid
  customerId     String?  @map("customer_id") @db.Uuid
  status         String   @default("OPEN") @db.VarChar(24) // OPEN, RESOLVED, SNOOZED
  title          String?  @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  channel          Channel                    @relation(fields: [channelId, organizationId], references: [id, organizationId], onDelete: Restrict)
  customer         Customer?                  @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  messages         Message[]
  automationAudits AutomationExecutionAudit[]

  @@unique([id, organizationId], name: "uq_conversations_id_org")
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderType     String   @map("sender_type") @db.VarChar(24) // CUSTOMER, AGENT, AI, SYSTEM
  content        String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  conversation Conversation        @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  attachments  MessageAttachment[]

  @@unique([id, organizationId], name: "uq_messages_id_org")
  @@index([organizationId, conversationId])
  @@map("messages")
}

model MessageAttachment {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  messageId       String    @map("message_id") @db.Uuid
  fileName        String    @map("file_name") @db.VarChar(255)
  fileType        String    @map("file_type") @db.VarChar(128)
  fileSize        Int       @map("file_size")
  storageKey      String    @map("storage_key") @db.VarChar(512)
  storageProvider String    @default("LOCAL") @map("storage_provider") @db.VarChar(32)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz()

  message      Message      @relation(fields: [messageId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([id, organizationId], name: "uq_message_attachments_id_org")
  @@index([organizationId, messageId])
  @@index([organizationId, createdAt])
  @@map("message_attachments")
}

// ==============================================================================
// 3. SYSTEM CATALOGS & ROUTING METADATA (Categories B & C)
// ==============================================================================

model ChannelRoutingLookup {
  id                String   @id @default(uuid()) @db.Uuid
  provider          String   @db.VarChar(32)
  externalAccountId String   @map("external_account_id") @db.VarChar(128)
  channelId         String   @map("channel_id") @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  status            String   @default("ACTIVE") @db.VarChar(24)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  channel Channel @relation(fields: [channelId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([provider, externalAccountId], name: "uq_channel_routing_provider_ext")
  @@index([organizationId, channelId])
  @@map("channel_routing_lookups")
}

model AiModelPricingSchedule {
  id                      String    @id @default(uuid()) @db.Uuid
  provider                String    @db.VarChar(32)
  canonicalModel          String    @map("canonical_model") @db.VarChar(64)
  modelAlias              String?   @map("model_alias") @db.VarChar(64)
  pricingVersion          String    @map("pricing_version") @db.VarChar(32)
  promptTokenRatePerM     Decimal   @map("prompt_token_rate_per_m") @db.Decimal(10, 6)
  completionTokenRatePerM Decimal   @map("completion_token_rate_per_m") @db.Decimal(10, 6)
  currency                String    @default("USD") @db.VarChar(8)
  effectiveFrom           DateTime  @map("effective_from") @db.Timestamptz()
  effectiveTo             DateTime? @map("effective_to") @db.Timestamptz()
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([provider, canonicalModel, pricingVersion], name: "uq_pricing_provider_model_version")
  @@index([provider, canonicalModel, effectiveFrom, effectiveTo])
  @@map("ai_model_pricing_schedules")
}

// ==============================================================================
// 4. TENANT-DOMAIN AI ASSISTANT & COST TRACKING MODELS (Category A — RLS)
// ==============================================================================

model AiConfiguration {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  name               String    @db.VarChar(128)
  systemInstructions String    @map("system_instructions") @db.Text
  policyRules        Json      @default("[]") @map("policy_rules")
  provider           String    @default("MOCK") @db.VarChar(32) // MOCK, OPENAI, ANTHROPIC
  model              String    @default("gpt-4o-mini") @db.VarChar(64)
  temperature        Decimal   @default(0.3) @db.Decimal(3, 2)
  status             String    @default("DRAFT") @db.VarChar(24) // DRAFT, ACTIVE, ARCHIVED
  version            Int       @default(1)
  approvedAt         DateTime? @map("approved_at") @db.Timestamptz()
  approvedByUserId   String?   @map("approved_by_user_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([id, organizationId], name: "uq_ai_configs_id_org")
  @@index([organizationId, status])
  @@map("ai_configurations")
}

model AiRequest {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(255)
  status         String   @default("PENDING") @db.VarChar(24) // PENDING, COMPLETED, FAILED, BYPASSED
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  attempts   AiRequestAttempt[]
  usageEvent AiUsageEvent?

  @@unique([id, organizationId], name: "uq_ai_requests_id_org")
  @@unique([organizationId, idempotencyKey], name: "uq_ai_requests_org_idempotency")
  @@index([organizationId, conversationId])
  @@map("ai_requests")
}

model AiRequestAttempt {
  id                       String   @id @default(uuid()) @db.Uuid
  organizationId           String   @map("organization_id") @db.Uuid
  requestId                String   @map("request_id") @db.Uuid
  provider                 String   @db.VarChar(32)
  model                    String   @db.VarChar(64)
  promptTokens             Int      @default(0) @map("prompt_tokens")
  completionTokens         Int      @default(0) @map("completion_tokens")
  incurredCostUsd          Decimal? @map("incurred_cost_usd") @db.Decimal(10, 6)
  costReconciliationStatus String   @default("PENDING") @map("cost_reconciliation_status") @db.VarChar(24) // PENDING, KNOWN, ESTIMATED, UNKNOWN
  isTenantBillable         Boolean  @default(false) @map("is_tenant_billable")
  status                   String   @default("PENDING") @db.VarChar(24) // PENDING, SUCCESS, TIMEOUT, ERROR
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz()

  request AiRequest @relation(fields: [requestId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId], name: "uq_ai_request_attempts_id_org")
  @@index([organizationId, requestId])
  @@map("ai_request_attempts")
}

model AiUsageEvent {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  requestId         String   @unique @map("request_id") @db.Uuid
  totalTokens       Int      @map("total_tokens")
  billableAmountUsd Decimal  @map("billable_amount_usd") @db.Decimal(10, 6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()

  request AiRequest @relation(fields: [requestId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([requestId, organizationId], name: "uq_ai_usage_request_org")
  @@unique([id, organizationId], name: "uq_ai_usage_events_id_org")
  @@index([organizationId, createdAt])
  @@map("ai_usage_events")
}

// ==============================================================================
// 5. TENANT-DOMAIN AUTOMATION ENGINE MODELS (Category A — Governed by RLS)
// ==============================================================================

model AutomationRule {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(128)
  trigger        String    @db.VarChar(32) // CONVERSATION_CREATED, MESSAGE_RECEIVED, CONVERSATION_RESOLVED
  conditions     Json      @default("[]") // Array of { field, operator, value }
  actions        Json      @default("[]") // Array of { type, payload }
  enabled        Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  audits       AutomationExecutionAudit[]

  @@unique([id, organizationId], name: "uq_automation_rules_id_org")
  @@index([organizationId, trigger, enabled])
  @@map("automation_rules")
}

model AutomationExecutionAudit {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  ruleId          String   @map("rule_id") @db.Uuid
  conversationId  String   @map("conversation_id") @db.Uuid
  trigger         String   @db.VarChar(32)
  matched         Boolean  @default(false)
  actionsExecuted Json     @default("[]") @map("actions_executed")
  status          String   @default("SUCCESS") @db.VarChar(24) // SUCCESS, FAILED, SKIPPED
  errorMessage    String?  @map("error_message") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  rule         AutomationRule @relation(fields: [ruleId, organizationId], references: [id, organizationId], onDelete: Cascade)
  conversation Conversation   @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId], name: "uq_automation_audits_id_org")
  @@index([organizationId, conversationId])
  @@index([organizationId, ruleId])
  @@map("automation_execution_audits")
}

model WebhookEvent {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  channelId         String    @map("channel_id") @db.Uuid
  provider          String    @db.VarChar(32)
  idempotencyKey    String    @map("idempotency_key") @db.VarChar(255)
  dispatchStatus    String    @default("PENDING_DISPATCH") @map("dispatch_status") @db.VarChar(24)
  dispatchToken     String?   @map("dispatch_token") @db.Uuid
  dispatchExpiresAt DateTime? @map("dispatch_expires_at") @db.Timestamptz()
  processingStatus  String    @default("UNCLAIMED") @map("processing_status") @db.VarChar(24)
  payload           Json
  attemptCount      Int       @default(0) @map("attempt_count")
  maxAttempts       Int       @default(5) @map("max_attempts")
  leaseToken        String?   @map("lease_token") @db.Uuid
  leaseExpiresAt    DateTime? @map("lease_expires_at") @db.Timestamptz()
  lastError         String?   @map("last_error") @db.Text
  nextRetryAt       DateTime? @map("next_retry_at") @db.Timestamptz()
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  processedAt       DateTime? @map("processed_at") @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  channel      Channel      @relation(fields: [channelId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId], name: "uq_webhook_events_id_org")
  @@unique([organizationId, channelId, provider, idempotencyKey], name: "uq_webhook_provider_event")
  @@index([dispatchStatus, createdAt, dispatchExpiresAt], name: "idx_webhook_dispatch_sweeper")
  @@index([processingStatus, leaseExpiresAt, nextRetryAt], name: "idx_webhook_processing_sweeper")
  @@index([organizationId, createdAt], name: "idx_webhook_org_created")
  @@map("webhook_events")
}

model Subscription {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String   @unique @map("organization_id") @db.Uuid
  stripeCustomerId     String?  @map("stripe_customer_id") @db.VarChar(128)
  stripeSubscriptionId String?  @unique @map("stripe_subscription_id") @db.VarChar(128)
  planTier             String   @default("FREE") @map("plan_tier") @db.VarChar(32)
  status               String   @default("ACTIVE") @db.VarChar(32)
  currentPeriodStart   DateTime @default(now()) @map("current_period_start") @db.Timestamptz()
  currentPeriodEnd     DateTime @default(dbgenerated("(CURRENT_TIMESTAMP + '30 days'::interval)")) @map("current_period_end") @db.Timestamptz()
  cancelAtPeriodEnd    Boolean  @default(false) @map("cancel_at_period_end")
  seatLimit            Int      @default(5) @map("seat_limit")
  aiTokenAllowance     Int      @default(100000) @map("ai_token_allowance")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([id, organizationId], name: "uq_subscriptions_id_org")
  @@index([organizationId])
  @@index([stripeCustomerId])
  @@index([status])
  @@map("subscriptions")
}

model KnowledgeDocument {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  title          String   @db.VarChar(255)
  sourceType     String   @default("MANUAL_ENTRY") @map("source_type") @db.VarChar(50)
  content        String   @db.Text
  status         String   @default("ACTIVE") @db.VarChar(50)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chunks       KnowledgeChunk[]

  @@unique([id, organizationId], name: "uq_knowledge_documents_id_org")
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id             String                      @id @default(uuid()) @db.Uuid
  organizationId String                      @map("organization_id") @db.Uuid
  documentId     String                      @map("document_id") @db.Uuid
  chunkIndex     Int                         @map("chunk_index")
  chunkText      String                      @map("chunk_text") @db.Text
  tokenCount     Int                         @default(0) @map("token_count")
  embedding      Unsupported("vector(1536)")
  metadata       Json                        @default("{}")
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document     KnowledgeDocument @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId], name: "uq_knowledge_chunks_id_org")
  @@index([organizationId, documentId])
  @@map("knowledge_chunks")
}


